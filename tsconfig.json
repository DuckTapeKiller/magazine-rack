{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2018",
		"noImplicitAny": true,
		"strict": true,
		"skipLibCheck": true,
		"importHelpers": true,
		"isolatedModules": true,
		"useUnknownInCatchVariables": true,
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2021"
		],
		"types": []
	},
	"include": [
		"src/**/*.ts"
	]
}
