{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2018",
		"noImplicitAny": true,
		"strict": true,
		"skipLibCheck": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"useUnknownInCatchVariables": true,
		"lib": ["DOM", "DOM.Iterable", "ES2021"],
		"types": []
	},
	"include": ["src/**/*.ts"]
}
