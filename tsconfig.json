{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2018",
		"noImplicitAny": true,
		"strict": true,
		"skipLibCheck": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"useUnknownInCatchVariables": true,
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2021"
		],
		"types": [],
		"paths": {
			"defuddle/full": [
				"node_modules/defuddle/dist/index.full.d.ts"
			],
			"knap/html": [
				"node_modules/knap/dist/html.d.ts"
			]
		}
	},
	"include": [
		"src/**/*.ts"
	]
}
